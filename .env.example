# Copie este arquivo como .env.local para desenvolvimento local
# Na Vercel, adicione estas variáveis em Settings > Environment Variables

# Supabase
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpsadadXVCJ9...

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000

# Melhor Envio (cálculo de frete + etiqueta de envio dos pedidos da loja)
# Token em: melhorenvio.com.br -> Integrações -> Permissões de acesso -> Gerar novo token
# (marque as permissões de cart, shipping, orders e balance). Token de sandbox só funciona
# com MELHOR_ENVIO_SANDBOX=true, e o de produção só com false.
MELHOR_ENVIO_TOKEN=
# "true" usa o ambiente de testes sandbox.melhorenvio.com.br (não cobra de verdade)
MELHOR_ENVIO_SANDBOX=true
# CEP de onde os produtos são enviados (sem traço)
CEP_ORIGEM=
# Dados de quem envia (aparecem na etiqueta). CPF e telefone só números.
REMETENTE_NOME=
REMETENTE_CPF=
REMETENTE_TELEFONE=
REMETENTE_EMAIL=
REMETENTE_ENDERECO=
REMETENTE_NUMERO=
REMETENTE_COMPLEMENTO=
REMETENTE_BAIRRO=
REMETENTE_CIDADE=
REMETENTE_UF=
# Etiqueta: por padrão é gerada no admin (Pedidos -> "Gerar etiqueta") quando o produto
# estiver pronto, porque os produtos têm tempo de produção e a etiqueta tem prazo para
# ser postada. "true" gera sozinha assim que o pagamento é aprovado.
ETIQUETA_AUTOMATICA=false
# IMPORTANTE: a etiqueta é paga com o saldo da CARTEIRA do Melhor Envio (pré-pago,
# separado do Mercado Pago). Sem saldo, o admin mostra "Sem saldo no Melhor Envio";
# recarregue e clique em "Gerar etiqueta" de novo.

# URL pública do seu site (sem barra no final)
SITE_URL=

# Senha do painel admin (modo simples: uma senha para todos)
ADMIN_PASSWORD=troque_essa_senha_aqui
# Opcional: uma senha por pessoa. Quando definido, o login pede usuário + senha
# e ADMIN_PASSWORD deixa de ser usado. Formato: usuario:senha,usuario2:senha2
ADMIN_USERS=
# Opcional: segredo para assinar as sessões do painel (string longa e aleatória).
# Se vazio, é derivado das senhas — trocar a senha derruba todas as sessões.
ADMIN_SESSION_SECRET=

# E-mails automáticos (confirmação de compra, rastreio, aviso de orçamento) via Resend
# Crie a conta em https://resend.com, verifique o domínio e gere a API key.
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: Nexus Band <contato@nexusband.com.br>
EMAIL_REMETENTE=
# E-mail da banda que recebe avisos de novos pedidos pagos e pedidos de orçamento.
# Também é o reply-to dos e-mails aos clientes: se o cliente responder, chega aqui.
EMAIL_BANDA=

# Integração com o app da banda: o app publica shows fechados em /api/integracao/shows
# mandando este valor no cabeçalho X-Nexus-Token. Use uma senha longa (16+ caracteres).
INTEGRACAO_TOKEN=
