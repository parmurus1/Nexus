# Copie este arquivo como .env.local para desenvolvimento local
# Na Vercel, adicione estas variáveis em Settings > Environment Variables

# Supabase
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpsadadXVCJ9...

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000

# Melhor Envio (cálculo de frete + geração automática de etiqueta na aba Merch)
# Gere o TOKEN PESSOAL em: https://melhorenvio.com.br -> Gerenciar -> Tokens
# (não precisa do fluxo OAuth2 completo com redirect; o token pessoal já é OAuth2
# por baixo dos panos e é o mais simples para uma loja própria como esta)
MELHOR_ENVIO_TOKEN=
# "true" para usar o ambiente sandbox.melhorenvio.com.br (testes, sem cobrar de verdade)
MELHOR_ENVIO_SANDBOX=true
# CEP de onde os produtos são enviados (sem traço)
CEP_ORIGEM=
# IMPORTANTE: a compra de etiquetas debita da CARTEIRA do Melhor Envio, que é
# um saldo pré-pago separado do Mercado Pago. Mantenha saldo na carteira
# (melhorenvio.com.br -> Minha Carteira) ou a geração automática da etiqueta
# vai falhar com status "falha_saldo" (o pagamento do cliente é confirmado
# normalmente mesmo assim — só a etiqueta fica pendente para gerar manualmente).

# URL pública do seu site (sem barra no final)
SITE_URL=

# Senha do painel admin
ADMIN_PASSWORD=troque_essa_senha_aqui
